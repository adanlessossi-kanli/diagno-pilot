# ─── LLM Configuration ────────────────────────────────────────────────────────
# Primary LLM (e.g. local Ollama or any OpenAI-compatible endpoint)
LLM_PRIMARY_URL=http://localhost:11434/v1
LLM_PRIMARY_API_KEY=your_primary_llm_api_key

# Fallback LLM (e.g. OpenAI GPT)
# ⚠️ Never commit real API keys — use environment variables or a secrets manager
LLM_FALLBACK_URL=https://api.openai.com/v1
LLM_FALLBACK_API_KEY=your_openai_api_key_here

# Embedding model name
EMBED_MODEL=text-embedding-ada-002

# LLM request timeout in seconds (default: 60, increase for CPU-only model)
LLM_TIMEOUT=120

# ─── Model Container (local llama.cpp) ────────────────────────────────────────
# Priority: MODEL_CONTAINER_URL (if non-empty) > LLM_PRIMARY_URL
# Leave empty to use LLM_PRIMARY_URL as the primary endpoint
MODEL_CONTAINER_URL=
MODEL_CONTAINER_API_KEY=
MODEL_GPU_LAYERS=99
MODEL_CONTEXT_SIZE=4096
MODEL_THREADS=4

# ─── LlamaIndex Pipeline ──────────────────────────────────────────────────────
LLAMAINDEX_CHUNK_SIZE=512
LLAMAINDEX_CHUNK_OVERLAP_TOKENS=50
LLAMAINDEX_SIMILARITY_THRESHOLD=0.75

# ─── HIPAA Compliance ─────────────────────────────────────────────────────────
# REQUIRED in production: encryption key for AES-256-GCM field-level encryption
# Generate a key with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
HIPAA_ENCRYPTION_KEY_ID=
HIPAA_AUDIT_HASH_CHAIN_ENABLED=true
# REQUIRED enabled in production: strip PHI before external LLM fallback calls
HIPAA_PHI_STRIP_ON_FALLBACK=true

# ─── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production: generate with `openssl rand -hex 32`
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB authentication credentials
MONGO_USERNAME=diagno_dev
MONGO_PASSWORD=diagno_dev_pass
# ⚠️ If you have an existing mongo_data volume without auth, you must remove it
# before the first start with authentication:
#   docker compose down -v
MONGODB_URI=mongodb://diagno_dev:diagno_dev_pass@mongo:27017/diagno_pilot?authSource=admin

# ─── Cache / Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=diagno_redis_dev
REDIS_URL=redis://:diagno_redis_dev@redis:6379/0

# Internal URL used by the Next.js auth proxy to reach the backend.
# In Docker: http://backend:8000 (service name). Outside Docker: http://localhost:8000
BACKEND_INTERNAL_URL=http://backend:8000

# ─── AWS / LocalStack ─────────────────────────────────────────────────────────
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=diagno-pilot-files

# ─── Application ──────────────────────────────────────────────────────────────
# "development" | "staging" | "production"
ENV=development

# Diagnosis execution path: "rag" (default), "mcp" (multi-agent MCP), or "agent" (AgentPipeline)
DIAGNOSIS_MODE=rag

# Comma-separated list of allowed CORS origins (use * only in development)
ALLOWED_ORIGINS=http://localhost:3000

# Content-Security-Policy header value for API responses
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'

# Logging: "json" | "text"
LOG_FORMAT=json
LOG_LEVEL=INFO

# Prometheus metrics Basic Auth (format: "user:password", leave empty to disable)
METRICS_AUTH=

# Rate limiting storage (use redis://... in production)
RATE_LIMIT_STORAGE_URI=memory://
