# ─── LLM Configuration ────────────────────────────────────────────────────────
# Primary LLM (e.g. local Ollama or any OpenAI-compatible endpoint)
LLM_PRIMARY_URL=http://localhost:11434/v1
LLM_PRIMARY_API_KEY=your_primary_llm_api_key

# Fallback LLM (e.g. OpenAI GPT)
LLM_FALLBACK_URL=https://api.openai.com/v1
LLM_FALLBACK_API_KEY=your_openai_api_key

# Embedding model name
EMBED_MODEL=text-embedding-ada-002

# LLM request timeout in seconds (default: 60)
LLM_TIMEOUT=60

# ─── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production: generate with `openssl rand -hex 32`
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongo:27017/diagno_pilot

# ─── AWS / LocalStack ─────────────────────────────────────────────────────────
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=diagno-pilot-files

# ─── Application ──────────────────────────────────────────────────────────────
# "development" | "staging" | "production"
ENV=development

# Comma-separated list of allowed CORS origins (use * only in development)
ALLOWED_ORIGINS=*

# Logging: "json" | "text"
LOG_FORMAT=json
LOG_LEVEL=INFO

# Prometheus metrics Basic Auth (format: "user:password", leave empty to disable)
METRICS_AUTH=

# Rate limiting storage (use redis://... in production)
RATE_LIMIT_STORAGE_URI=memory://
